  "title": "RUIBench I1 · semantic step",
  "track": "controlled",
  "tools": [
   "camera_look",
   "camera_zoom",
   "robot_state",
   "vision_detect",
   "vision_segment",
   "vision_lift",
   "vision_pose",
   "robot_step",
   "robot_wait",
   "robot_stop",
   "task_info",
   "task_demo",
   "task_events",
   "task_done",
   "memory_note",
   "memory_recall",
   "memory_frames",
   "memory_scene",
   "vision_marks",
   "vision_point",
   "vision_track",
   "plan_grasps",
   "plan_motion",
   "plan_ik",
   "task_give_up"
  ],
  "code_tools": [],
  "channel": "tools",
  "hand_back": "each_step",
  "push": {
   "cameras": "all",
   "history": 2,
   "proprio": true,
   "events": true
  },
  "docs": "default",
  "perception": "model",
  "params": {
   "robot_step": {
    "micro_m": 0.0025,
    "fine_m": 0.01,
    "coarse_m": 0.04,
    "micro_deg": 2.0,
    "fine_deg": 5.0,
    "coarse_deg": 15.0
   },
   "vision_marks": {
    "style": "dots"
   },
   "vision_point": {
    "impl": "detector"
   },
   "vision_track": {
    "impl": "redetect"
   },
   "plan_grasps": {
    "impl": "box"
   },
   "plan_motion": {
    "impl": "lift"
   }
  },
  "dialect": "step",
  "plugins": [
   "aids"
  ],
  "_reproduces": "Show-Harness semantic action tokens (MV_*, ROTATE_*, GRASP, RELEASE)",
  "_differences": "tokens are enum arguments of robot_step instead of JSON text; tilt and micro steps added; a step may repeat up to 5 times in one reply (extension)",
  "_guide": ""
 },
